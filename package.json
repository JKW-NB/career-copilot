{
  "name": "career-copilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "tauri": "tauri",
    "dev:desktop": "vite --configLoader runner --host 127.0.0.1 --port 1420 --strictPort",
    "check:rust": "cargo check --locked --manifest-path src-tauri/Cargo.toml && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test:desktop": "node tests/desktop/smoke.mjs",
    "dev": "vite --configLoader runner --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite --configLoader runner build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:docs": "node --test tests/docs.test.mjs",
    "test:unit": "vitest run --configLoader runner",
    "test:e2e": "playwright test",
    "test": "npm run test:docs && npm run test:unit",
    "check": "npm run test && npm run typecheck && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "1.42.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
